# Names only — never commit real values. Copy to .env.local for local runs.
# On Vercel, set these in Project Settings → Environment Variables.

# Public (inlined into the browser bundle). Needed for the live hub AND admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional public origin for Open Graph / canonical URLs.
# If unset, VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL is used at runtime.
NEXT_PUBLIC_SITE_URL=

# Server-only. Required for public hub assemble (Edge `candidates` uses x-admin-secret)
# and for /admin login. Not NEXT_PUBLIC.
ADMIN_SECRET=

# Server-only. Mapillary Graph API for /api/mapillary/[id] and photo import.
# Hub still renders without it if candidates already have photo_url.
MAPILLARY_ACCESS_TOKEN=

# Server-only. Optional. Never required. If set, assemble prefers a Places photo
# URL already stored on the candidate — this app does not call paid Google APIs.
GOOGLE_MAPS_API_KEY=
